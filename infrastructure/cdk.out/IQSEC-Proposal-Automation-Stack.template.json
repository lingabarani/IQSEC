  "PipelineIQSECProposalStateMachineFC194009": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": "{\"StartAt\":\"1. Register Opportunity & Scopes\",\"States\":{\"1. Register Opportunity & Scopes\":{\"Type\":\"Pass\",\"Comment\":\"Stage 1: Validates Cognito tokens and registers opportunity in RDS\",\"Next\":\"2. Ingest S3 Documents\"},\"2. Ingest S3 Documents\":{\"Type\":\"Pass\",\"Comment\":\"Stage 2: Checks uploaded RFP documents in S3\",\"Next\":\"3. Hybrid OCR & Provenance Chunking\"},\"3. Hybrid OCR & Provenance Chunking\":{\"Type\":\"Pass\",\"Comment\":\"Stage 3: Executes PyMuPDF + PaddleOCR fallback, emitting Doc-Page-Chunk hierarchy\",\"Next\":\"4. Extract Requirements & Addendums\"},\"4. Extract Requirements & Addendums\":{\"Type\":\"Pass\",\"Comment\":\"Stage 4: Extracts discrete requirements and resolves clarification minutes amendments\",\"Next\":\"5. Classify Requirements\"},\"5. Classify Requirements\":{\"Type\":\"Pass\",\"Comment\":\"Stage 5: Categorizes requirements into SOC_CORE, SIEM, EDR, etc.\",\"Next\":\"6. Scoped RAG & Cross-Encoder Reranking\"},\"6. Scoped RAG & Cross-Encoder Reranking\":{\"Type\":\"Pass\",\"Comment\":\"Stage 6: Executes pre-filtered hybrid search on OpenSearch & reranks Top-25 to Top-3\",\"Next\":\"7. Match Product & Service Catalog\"},\"7. Match Product & Service Catalog\":{\"Type\":\"Pass\",\"Comment\":\"Stage 7: Maps requirement to IQSEC solutions and manufacturer directory\",\"Next\":\"8. Private AI Reasoning & Guardrails\"},\"8. Private AI Reasoning & Guardrails\":{\"Type\":\"Pass\",\"Comment\":\"Stage 8: Ollama/vLLM drafts compliance; guardrails flag NOT_ENOUGH_EVIDENCE\",\"Next\":\"9. Human Validation Gate (Approve -- Edit -- Reject)\"},\"9. Human Validation Gate (Approve -- Edit -- Reject)\":{\"Type\":\"Pass\",\"Comment\":\"Stage 9: Pauses state machine until Pre-Sales Analyst approves matrix via UI\",\"Next\":\"10. Commit Validated Sábana Matrix\"},\"10. Commit Validated Sábana Matrix\":{\"Type\":\"Pass\",\"Comment\":\"Stage 10: Commits approved matrix into Amazon RDS PostgreSQL\",\"Next\":\"11. Generate Multi-Deliverables\"},\"11. Generate Multi-Deliverables\":{\"Type\":\"Pass\",\"Comment\":\"Stage 11: Generates XLSX Sábana, DOCX Proposal, and PPTX Presentation\",\"Next\":\"12. Audit Trail & Metrics Telemetry\"},\"12. Audit Trail & Metrics Telemetry\":{\"Type\":\"Pass\",\"Comment\":\"Stage 12: Logs execution metrics to CloudWatch and marks opportunity COMPLETED\",\"End\":true}},\"TimeoutSeconds\":14400}",
    "LoggingConfiguration": {
     "Destinations": [
      {
       "CloudWatchLogsLogGroup": {
        "LogGroupArn": {
         "Fn::GetAtt": [
          "PipelineIQSECStateMachineLogs3AFE1502",
          "Arn"
         ]
        }
       }
      }
     ],
     "IncludeExecutionData": true,
     "Level": "ALL"
    },
    "RoleArn": {
     "Fn::GetAtt": [
      "PipelineIQSECProposalStateMachineRole54B11FF7",
      "Arn"
     ]
    },
    "StateMachineName": "IQSEC-AI-Proposal-Workflow"
   },
   "DependsOn": [
    "PipelineIQSECProposalStateMachineRoleDefaultPolicy483B4CEC",
    "PipelineIQSECProposalStateMachineRole54B11FF7"
   ],
