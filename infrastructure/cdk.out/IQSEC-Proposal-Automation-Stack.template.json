           },
           ":iam::251388487610:root"
          ]
         ]
        }
       },
       "Resource": "*"
      },
      {
       "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey"
       ],
       "Condition": {
        "StringEquals": {
